MONGODB_URL=
MONGODB_DB_NAME=
TEST_MONGODB_URL=
TEST_MONGODB_DB_NAME=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# If set, ADMIN-role accounts can only log in from this exact origin (the admin app's
# URL, e.g. http://localhost:5174 in dev) -- correct admin credentials are rejected from
# any other origin, and non-admin credentials are rejected from this one. Leave blank to
# disable this check (e.g. early local dev before you care about enforcing the split).
ADMIN_ORIGIN=

ENVIRONMENT=development
DEBUG=true

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Admin

# Self-service password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Player frontend origin -- used to build the reset link sent by email.
FRONTEND_URL=http://localhost:5173

# SMTP (optional in development -- if SMTP_HOST is blank, reset emails are logged instead of
# sent. Must be set for production; validate_production_config refuses to boot without it.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@arenaroadx.com
SMTP_USE_TLS=true
